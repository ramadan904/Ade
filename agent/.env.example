# Chain to talk to. Local: anvil's default. Robinhood Chain testnet: https://rpc.testnet.chain.robinhood.com/rpc
RPC_URL=http://127.0.0.1:8545

# The agent's own key. It only needs gas money: it never holds user funds.
AGENT_PRIVATE_KEY=

# Claude plans the buys. Without a key the agent uses the deterministic rules planner.
ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-opus-5-5

# How far below the quote the agent sets minOut (never more than the vault's own maxSlippageBps).
AGENT_SLIPPAGE_BPS=50
AGENT_MIN_ORDER_USD=1

# Only for the helper CLIs:
KEEPER_PRIVATE_KEY=
OWNER_PRIVATE_KEY=

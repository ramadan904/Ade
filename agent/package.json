{
  "name": "stockpilot-agent",
  "version": "0.1.0",
  "private": true,
  "description": "The Stockpilot agent: plans stock-token buys with Claude and executes them through guardrailed vaults.",
  "type": "module",
  "scripts": {
    "agent": "tsx src/run.ts",
    "keeper": "tsx src/keeper.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "create-vault": "tsx src/create-vault.ts",
    "build:web": "esbuild src/web-lib.ts --bundle --format=esm --minify --target=es2022 --outfile=../web/vendor/lib.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "viem": "^2.57.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "playwright": "1.56",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
